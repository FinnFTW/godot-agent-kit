; Engine configuration file.
; It's actually a TOML-like file. This project is Agent Kit's own test bed: the addon lives in
; addons/agent_kit, the demo scene and tuning data in demo/, the kit's own tests in tests/.

config_version=5

[application]

config/name="Agent Kit"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/agent_kit/plugin.cfg")
